{
  "name": "app-movilidad-urbana",
  "version": "0.1.0",
  "description": "Plataforma de viajes urbanos en tiempo real (TP Programacion IV - UTN FRRe)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/servidor.js",
    "start": "node --env-file-if-exists=.env src/servidor.js",
    "setup": "npm run migrate && npm run seed",
    "migrate": "node --env-file=.env src/infra/db/migrar.js",
    "seed": "node --env-file=.env src/infra/db/seed.js",
    "test": "node --env-file=.env --test --test-concurrency=1",
    "test:dominio": "node --env-file=.env --test tests/dominio/*.test.js",
    "test:integracion": "node --env-file=.env --test tests/integracion/*.test.js",
    "test:concurrencia": "node --env-file=.env --test tests/concurrencia/aceptacion-simultanea.test.js",
    "test:concurrencia:repetido": "node --env-file=.env tests/concurrencia/repetir-aceptacion-simultanea.js",
    "lint": "eslint .",
    "web:install": "npm --prefix web ci",
    "web:dev": "npm --prefix web run dev",
    "e2e": "playwright test",
    "carga:seed": "node --env-file=.env scripts/carga/seed-choferes-carga.js",
    "carga:simulador": "node --env-file=.env scripts/carga/simulador-choferes.js",
    "carga:autocannon": "node --env-file=.env scripts/carga/carga-autocannon.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "autocannon": "^8.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.14.0"
  }
}

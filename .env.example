# ============ Copiar a .env (NUNCA se versiona) ============
# Windows PowerShell: Copy-Item .env.example .env

# Proceso
NODE_ENV=development
HOST=localhost
PUERTO_HTTP=3000

# Base de datos (docker compose usa DB_PUERTO_HOST)
DB_HOST=localhost
DB_PUERTO=5432
DB_NOMBRE=movilidad
DB_USUARIO=movilidad
DB_PASSWORD=cambiar_esta_clave_local
DB_PUERTO_HOST=5432
DATABASE_URL=postgres://movilidad:cambiar_esta_clave_local@localhost:5432/movilidad

# Seguridad
JWT_SECRETO=cambiar_este_secreto_por_uno_aleatorio_de_32_caracteres
JWT_EMISOR=app-movilidad-urbana
JWT_AUDIENCIA=app-movilidad-urbana

# HTTP
CORS_ORIGENES=http://localhost:5173
LIMITE_CUERPO_BYTES=102400
RATE_LIMIT_VENTANA_MS=60000
RATE_LIMIT_MAX_PETICIONES=100


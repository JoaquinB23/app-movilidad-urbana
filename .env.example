# ============ Copiar a .env (NUNCA se versiona) ============
# Windows PowerShell: Copy-Item .env.example .env

# Proceso
NODE_ENV=development
HOST=localhost
PUERTO_HTTP=3000
# fatal | error | warn | info | debug | trace | silent
LOG_NIVEL=info
# Espera maxima del apagado ordenado antes de cortar conexiones SSE abiertas
APAGADO_TIMEOUT_MS=10000

# Base de datos (docker compose usa DB_PUERTO_HOST)
DB_HOST=localhost
DB_PUERTO=5432
DB_NOMBRE=movilidad
DB_NOMBRE_TEST=movilidad_test
DB_USUARIO=movilidad
DB_PASSWORD=cambiar_esta_clave_local
DB_PUERTO_HOST=5432
DATABASE_URL=postgres://movilidad:cambiar_esta_clave_local@localhost:5432/movilidad
DATABASE_URL_TEST=postgres://movilidad:cambiar_esta_clave_local@localhost:5432/movilidad_test
# Conexiones simultaneas a PostgreSQL desde la API (default 10, maximo 80)
DB_POOL_MAX=10

# Seguridad
JWT_SECRETO=cambiar_este_secreto_por_uno_aleatorio_de_32_caracteres
JWT_EMISOR=app-movilidad-urbana
JWT_AUDIENCIA=app-movilidad-urbana
JWT_EXPIRACION=8h
# Costo de argon2id (bajar en tests, subir en produccion)
ARGON2_MEMORIA_KIB=65536
ARGON2_ITERACIONES=3
ARGON2_PARALELISMO=1
# Contraseña de los usuarios del seed (npm run seed). Solo para desarrollo.
SEED_PASSWORD=cambiar_esta_clave_demo

# Worker de reasignacion (variante H); el umbral vive en la tabla parametros
WORKER_REASIGNACION_INTERVALO_MS=10000

# Cola del historial de ubicaciones (flush por lote o por tiempo)
COLA_HISTORIAL_MAX_LOTE=200
COLA_HISTORIAL_INTERVALO_MS=1000

# Version real o ingenua (para las mediciones de docs/mediciones.md)
GEO_ESTRATEGIA=postgis
HISTORIAL_MODO=cola

# Retencion del historial de ubicaciones (job periodico)
RETENCION_DIAS=90
RETENCION_INTERVALO_MS=3600000

# HTTP
CORS_ORIGENES=http://localhost:5173
LIMITE_CUERPO_BYTES=102400
RATE_LIMIT_VENTANA_MS=60000
RATE_LIMIT_MAX_PETICIONES=100
# Login: por IP (fuerza bruta de credenciales). Ubicacion: por chofer autenticado.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_UBICACION_MAX=60

# Metricas Prometheus (GET /metrics). Si se define, exige Authorization: Bearer.
# METRICAS_TOKEN=un_token_largo_de_al_menos_16

# docker compose --profile app (API en contenedor)
API_PUERTO_HOST=3000

# docker compose --profile observabilidad (Grafana Alloy -> Grafana Cloud)
ALLOY_OBJETIVO_API=host.docker.internal:3000
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USUARIO=
GRAFANA_CLOUD_API_KEY=

# Cada cuanto se buscan ofertas vencidas (el tiempo limite es un parametro)
WORKER_VENCIMIENTO_INTERVALO_MS=1000
# Cada cuanto se retoman los viajes que siguen buscando chofer (busqueda
# continua; se prende con el parametro tiempo_busqueda_s > 0)
WORKER_BUSQUEDA_INTERVALO_MS=2000

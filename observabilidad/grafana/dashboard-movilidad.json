{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus (Grafana Cloud)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Movilidad urbana — API",
  "uid": "movilidad-api",
  "tags": ["movilidad", "node"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Servicio",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(http_request_duration_seconds_count, job)",
        "refresh": 2,
        "current": { "text": "app-movilidad-urbana", "value": "app-movilidad-urbana" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pedidos por segundo por ruta",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (metodo, ruta) (rate(http_request_duration_seconds_count{job=\"$job\"}[1m]))",
          "legendFormat": "{{metodo}} {{ruta}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latencia p50 / p95 / p99 (sin el stream SSE)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"$job\", ruta!=\"/viajes/:id/seguimiento\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"$job\", ruta!=\"/viajes/:id/seguimiento\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"$job\", ruta!=\"/viajes/:id/seguimiento\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latencia p95 por ruta",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, ruta) (rate(http_request_duration_seconds_bucket{job=\"$job\", ruta!=\"/viajes/:id/seguimiento\"}[1m])))",
          "legendFormat": "{{ruta}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Lag del event loop (monitorEventLoopDelay)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max(nodejs_eventloop_lag_p99_seconds{job=\"$job\"})",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "expr": "max(nodejs_eventloop_lag_max_seconds{job=\"$job\"})",
          "legendFormat": "máximo"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errores 5xx y rechazos 429 por segundo",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count{job=\"$job\", status=~\"5..\"}[1m]))",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_request_duration_seconds_count{job=\"$job\", status=\"429\"}[1m]))",
          "legendFormat": "429"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cola del historial de ubicaciones",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max(cola_historial_pendientes{job=\"$job\"})", "legendFormat": "pendientes" },
        { "refId": "B", "expr": "max(cola_historial_fallos{job=\"$job\"})", "legendFormat": "lotes fallidos (acumulado)" },
        { "refId": "C", "expr": "max(cola_historial_descartados{job=\"$job\"})", "legendFormat": "descartadas (acumulado)" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pool de PostgreSQL",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (estado) (pg_pool_conexiones{job=\"$job\"})",
          "legendFormat": "{{estado}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memoria del proceso",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max(process_resident_memory_bytes{job=\"$job\"})", "legendFormat": "RSS" },
        { "refId": "B", "expr": "max(nodejs_heap_size_used_bytes{job=\"$job\"})", "legendFormat": "heap usado" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU del proceso",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(process_cpu_seconds_total{job=\"$job\"}[1m]))",
          "legendFormat": "CPU"
        }
      ]
    }
  ]
}
